      "pain": {
        "critical": "8-10",
        "urgent": "5-7",
        "normal": "0-4",
        "note": "Numeric pain score on a 0-10 scale; pain severity should be interpreted with clinical context."
      }
    },

    "clinical_context": "Standard adult thresholds. Elevated BP or HR may be influenced by anxiety or pain."
  },

  "geriatric": {
    "age_range": "65+",

    "normal_ranges": {
      "respiratory_rate": {
        "critical": ">30",
        "urgent": "25-30",
        "normal": "12-22",
        "note": "Slightly higher than adult"
      },

      "heart_rate": {
        "critical": ">110 or <50",
        "urgent": "90-110 or 50-60",
        "normal": "60-90",
        "note": "Resting HR may be lower"
      },

      "spo2": {
        "critical": "<92%",
        "urgent": "92-94%",
        "normal": ">94%",
        "note": "Lower baseline SpO2 can occur; clinical context is important."
      },

      "systolic_bp": {
        "critical": ">180 or <100",
        "urgent": "160-180 or 100-110",
        "normal": "110-170",
        "note": "Lower BP tolerance; orthostatic hypotension risk"
      },

      "diastolic_bp": {
        "critical": ">120 or <60",
        "urgent": "100-120 or 60-65",
        "normal": "65-100",
        "note": "Prototype DBP thresholds; clinical context is required."
      },

      "temperature": {
        "critical": ">38.5°C",
        "urgent": "38.0-38.5°C",
        "normal": "<38.0°C",
        "note": "Older adults may have a reduced fever response; clinical context is important."
      },

      "pain": {
        "critical": "8-10",
        "urgent": "5-7",
        "normal": "0-4",
        "note": "Numeric pain score on a 0-10 scale; clinical context is required."
      }
    },

    "clinical_context": "Older adults can present atypically. Vague symptoms combined with abnormal vital signs require careful clinical evaluation."
  }

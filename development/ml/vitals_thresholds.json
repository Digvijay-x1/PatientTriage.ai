  "adult": {
    "age_range": "13-64",

    "normal_ranges": {
      "respiratory_rate": {
        "critical": ">30",
        "urgent": "25-30",
        "normal": "12-20"
      },

      "heart_rate": {
        "critical": ">130 or <50",
        "urgent": "100-130 or 50-60",
        "normal": "60-100"
      },

      "spo2": {
        "critical": "<94%",
        "urgent": "94-96%",
        "normal": ">96%"
      },

      "systolic_bp": {
        "critical": ">180 or <90",
        "urgent": "160-180 or 90-100",
        "normal": "100-160"
      },

      "diastolic_bp": {
        "critical": ">120 or <60",
        "urgent": "100-120 or 60-65",
        "normal": "65-100",
        "note": "Prototype DBP thresholds; clinical context is required."
      },

      "temperature": {
        "critical": ">39.5°C",
        "urgent": "38.5-39.5°C",
        "normal": "<38.5°C"
